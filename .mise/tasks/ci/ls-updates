#!/usr/bin/env bash
#MISE description="list the actions of .github/workflows with newer versions, change nothing"
set -euo pipefail

# pinact comes with the ci environment, see .mise/config.ci.toml
if [[ ",${MISE_ENV:-}," != *",ci,"* ]]; then
	echo "ls-updates needs pinact: run it as 'MISE_ENV=ci mise run ci:ls-updates'" >&2
	exit 1
fi

pinact run --update --check
